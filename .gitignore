# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
ENV/
env/

# ---- Environment / secrets ----
.env
.env.*
# ...but the template carries no secret and MUST be committed.
!.env.example
*.pem
*.key
credentials.json

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ---- Logs ----
*.log

# ---- Test / tool output ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Generated capture files.  test_dpi.pcap is a deliberate sample input and is
# tracked; everything else this project writes is output and is not.
*.pcap
!test_dpi.pcap

# ---- Evaluation output ----
# run_rag_evaluation.py writes these; they are measurements of a particular
# machine on a particular day, not source.  The numbers that matter are quoted
# in the step reports, and a stale 650 KB result committed here would be
# mistaken for the current one.
step*.json
step10-*.txt
step*-debug.txt
evaluation-*.json
