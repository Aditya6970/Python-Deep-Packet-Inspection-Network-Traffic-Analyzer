# Copy this file to `.env` and fill in what you need.  `.env` is gitignored.
#
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# The AI layer is OPTIONAL.  With nothing configured, the DPI engine works
# exactly as before and `analyze_ai.py` reports that analysis was skipped.

# ===========================================================================
# PROVIDER SELECTION
# ===========================================================================
# Which LLM provider to use: groq | ollama | openai
# An unrecognised value is refused rather than silently replaced.
DPI_LLM_PROVIDER=groq


# ===========================================================================
# GROQ  -- recommended for development (free tier, fast, strict JSON schema)
# ===========================================================================
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=

# Model.  The default is a current production model that supports strict
# structured outputs.  Groq retires models periodically -- if you get a
# model_not_found error, check https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-20b

# GROQ_BASE_URL=https://api.groq.com/openai/v1


# ===========================================================================
# OLLAMA  -- local fallback, no API key, no network required
# ===========================================================================
# Install from https://ollama.com, then:
#   ollama serve
#   ollama pull llama3.1
#
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Ollama's OpenAI-compatible layer requires the Authorization header to exist
# but ignores its value, so a placeholder is supplied automatically.  Set this
# only if you front Ollama with something that does check the header.
# OLLAMA_API_KEY=


# ===========================================================================
# OPENAI  -- optional; requires paid credits
# ===========================================================================
# A key on an account with no quota returns a rate-limit error.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini


# ===========================================================================
# SHARED TUNING  (applies to whichever provider is selected)
# ===========================================================================
# Hard wall-clock timeout, in seconds, for a single request.
# DPI_AI_TIMEOUT=30

# Retries for transient failures (429 / 5xx / timeout / connection refused).
# Authentication errors are never retried.
# DPI_AI_MAX_RETRIES=3

# Maximum flow records included in one request.
# DPI_AI_MAX_FLOWS=40

# IP handling: full | redact_private | none
# DPI_AI_IP_MODE=redact_private

# Generic model override, used only if the provider-specific one is unset.
# DPI_AI_MODEL=

# Generic endpoint override, used only if the provider-specific one is unset.
# DPI_AI_BASE_URL=

# ---------------------------------------------------------------------------
# Request size
# ---------------------------------------------------------------------------
# How the capture is laid out in the prompt: table | json
#
# "table" is the default and the production behaviour: column names once, then
# one row per flow.  Every flow, field and value is present -- nothing is
# dropped, rounded or truncated -- and the request is substantially smaller
# than the JSON layout it replaced.
#
# "json" restores the pre-2.0 pretty-printed layout byte for byte, for
# comparison or compatibility.
# DPI_CAPTURE_FORMAT=table

# Refuse a request whose estimated input size exceeds this, before sending it.
#
# Unset by default, deliberately: a per-request limit is a property of your
# provider account, which this project cannot observe, and a guessed ceiling
# would refuse requests that would have succeeded.  Set it if you know yours.
# The estimate counts the prompt AND the response schema the provider is sent
# alongside it.  Set to 0 to disable an inherited value.
# DPI_MAX_INPUT_TOKENS=

# ---------------------------------------------------------------------------
# Retrieval (RAG) context budget
# ---------------------------------------------------------------------------
# How much retrieved reference knowledge a single request may carry.  Applied
# after retrieval ranking and before the prompt is built, so it changes what is
# affordable without changing what is relevant.  Excerpts that do not fit are
# excluded whole and listed in the report -- never truncated.
#
# Capture data is NOT governed by this budget: DPI facts are the evidence and
# are never dropped to make room for commentary.
#
# Raise these if your provider has a generous limit; lower them if a request is
# rejected as too large.
# DPI_RAG_MAX_ITEMS=4
# DPI_RAG_MAX_CHARS=3000

# Estimated tokens, using a deliberately pessimistic 3.5 characters per token.
# Set to "none" to disable and let DPI_RAG_MAX_CHARS decide alone.
# DPI_RAG_MAX_TOKENS=900


# ---------------------------------------------------------------------------
# Embeddings  (needs: pip install -r requirements-rag.txt)
# ---------------------------------------------------------------------------
# The retrieval stage embeds locally -- no API key, no provider, no network
# once the model is cached.  First use downloads ~130 MB.
#
# The model.  Changing it changes the vector space, so an index built with one
# model cannot be searched with another; the code refuses rather than ranking
# meaningless numbers.
# DPI_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Require the cached copy and fail rather than fetch.  Set this on an offline
# or locked-down machine, or to make a missing cache loud instead of slow.
# DPI_EMBED_OFFLINE=1

# Torch device.  Left unset, sentence-transformers chooses.
# DPI_EMBED_DEVICE=cpu

# Texts per embedding batch.
# DPI_EMBED_BATCH_SIZE=16

# Model cache directory.  Left unset, the sentence-transformers default is used.
# DPI_EMBED_CACHE=


# ===========================================================================
# CONSOLE
# ===========================================================================
# The reports use Unicode box-drawing characters.  On Windows, piping to a file
# selects the locale encoding (often cp1252), which cannot encode them, so
# `dpi/console.py` re-points stdout/stderr at UTF-8 on import.  Set this to 1
# to skip that and manage the streams yourself.
# DPI_NO_CONSOLE_UTF8=1
